# Copy this file to .env.local and fill it in, then restart the site.

# Admin panel password (default is admin123 — change it!)
ADMIN_PASSWORD=change-me
# Any long random text; keeps admin logins secure
SESSION_SECRET=replace-with-a-long-random-string

# Your public web address (used for Google sitemap and link previews)
SITE_URL=https://www.yourstore.com
# Set to 1 once the site runs on https
COOKIE_SECURE=0

# Optional: email alerts for new orders & appointments (e.g. Gmail app password, Zoho, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where alerts go (defaults to the store email set in Admin → Settings)
NOTIFY_EMAIL=

# --- Only for Vercel / serverless hosting (added automatically when you connect the stores) ---
# Upstash Redis (Vercel → Storage → Upstash for Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob for uploaded photos (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=
