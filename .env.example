# Copy this file to .env.local (on your PC) or add these in Vercel → Settings → Environment Variables.
# Everything is optional — the site runs without any of them.

# --- Database ---
# On Vercel this is filled in for you when you connect Neon (Storage → Create Database → Neon).
# Leave empty on your PC: the site then uses a built-in database saved in the data/ folder.
DATABASE_URL=

# --- First admin account (optional) ---
# If both are set, an Owner account with these details is created automatically on first start.
# Otherwise just open /admin and create the owner account in the browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Any long random text. Keeps logins secure. (If empty, one is generated and stored in the database.)
SESSION_SECRET=

# Your public web address (used in password-reset links, sitemap and link previews)
SITE_URL=https://www.yourstore.com
# Set to 1 once the site runs on https (Vercel production does this automatically)
COOKIE_SECURE=0

# --- Email (optional): order/appointment alerts, welcome mails, password-reset mails ---
# Works with Gmail (app password), Zoho, Brevo, etc. Without it, staff create reset links in the admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where alerts go (defaults to the store email set in Admin → Settings)
NOTIFY_EMAIL=
